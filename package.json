{
  "name": "jupiter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @jupiter/api dev",
    "dev:web": "pnpm --filter @jupiter/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify:release": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "load:smoke": "node scripts/load-smoke.mjs"
  }
}
