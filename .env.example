# Local development values only. Never place production credentials in this file.
POSTGRES_DB=jupiter
POSTGRES_USER=jupiter
POSTGRES_PASSWORD=change-me-for-local-use
REDIS_PASSWORD=change-me-for-local-use
MINIO_ROOT_USER=jupiter-local
MINIO_ROOT_PASSWORD=change-me-for-local-use
API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:5432/jupiter
# Required in production. When absent locally, the API uses an in-memory secret
# and invalidates sessions at restart.
JWT_SECRET=
EMAIL_INGEST_SECRET=
# Public-account email verification. `local_test` is development-only and keeps
# the latest token in memory for the explicit local test endpoint; production
# should use `webhook` with an HTTPS mail-delivery endpoint, or `disabled`.
PUBLIC_ACCOUNT_VERIFICATION_DELIVERY=local_test
PUBLIC_ACCOUNT_VERIFICATION_WEBHOOK_URL=
PUBLIC_ACCOUNT_VERIFICATION_WEB_URL=http://127.0.0.1:5173/
# Base64-encoded 32-byte master key used only to encrypt per-organization AI credentials.
AI_CREDENTIAL_ENCRYPTION_KEY=
# Comma-separated production allowlist. Development also permits loopback HTTP providers.
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com
# Temporary migration source only. Import into an organization, then remove it.
OPENAI_API_KEY=
# Legacy provider variables retained only while older queued jobs are migrated.
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
TRANSCRIPTION_PROVIDER_URL=
TRANSCRIPTION_PROVIDER_API_KEY=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jupiter-attachments
S3_ACCESS_KEY_ID=jupiter-local
S3_SECRET_ACCESS_KEY=change-me-for-local-use
# Optional path to the local MinIO executable. The local helper otherwise uses
# %USERPROFILE%/.local/bin/minio.exe on Windows (or ~/.local/bin/minio).
MINIO_BIN=
# Optional local MinIO data directory. Defaults to .local/minio-data.
LOCAL_MINIO_DATA_DIR=
